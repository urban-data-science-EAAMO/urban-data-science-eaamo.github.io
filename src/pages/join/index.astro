---
import Layout from "@layouts/Layout.astro";
import LinkButton from "@components/LinkButton.astro";
---

<Layout title="Join Us | Urban Data & Equitable Cities" pageType="other">
  <main id="main-content" class="join-page px-4 sm:px-6">
    <section class="join-container">
      <div class="join-header">
        <h1 class="join-title">Urban Data & Equitable Cities</h1>
        <p class="join-subtitle">
          Subscribe to our mailing list to receive updates on talks, activities,
          and collaborations.
        </p>
      </div>

      <div class="join-form">
        <LinkButton
          className="btn-primary"
          href="https://lists.cornell.edu/URBAN-DATA-SCIENCE-RG-L/subscribe/"
          >Join Our Mailing List!</LinkButton
        >
      </div>

      <section class="join-next-steps" aria-labelledby="next-steps-title">
        <h2 id="next-steps-title">Next steps</h2>
        <ol>
          <li>Confirm your subscription using the link sent to your email.</li>
          <li>Wait for an admin to manually approve your subscription.</li>
          <li>
            Once approved, you will receive a link to join our Slack channel.
          </li>
        </ol>
      </section>

      <div class="join-links">
        <a class="underline" href="/">Back</a>
        <span aria-hidden>·</span>
        <a
          class="underline"
          href="https://bridges.eaamo.org/"
          target="_blank"
          rel="noopener">EAAMO Bridges</a
        >
      </div>
    </section>
  </main>
</Layout>

<style>
  #main-content.join-page {
    display: grid;
    place-items: center;
    min-height: 100svh;
    margin: 0;
    padding-top: 3rem;
    padding-bottom: 3rem;
  }

  .join-container {
    width: 100%;
    padding-bottom: 0;
    text-align: center;
  }

  .join-next-steps {
    margin-top: 2rem;
  }

  .join-next-steps h2 {
    font-size: 1.125rem;
    font-weight: 600;
    margin-bottom: 1rem;
  }

  .join-next-steps ol {
    display: inline-block;
    margin: 0;
    padding-left: 1.5rem;
    list-style: decimal;
    text-align: left;
    color: rgba(var(--color-text-base), 0.8);
  }

  .join-next-steps li + li {
    margin-top: 0.75rem;
  }
</style>
