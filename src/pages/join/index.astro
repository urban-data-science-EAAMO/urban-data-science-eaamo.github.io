---
import Layout from "@layouts/Layout.astro";
import LinkButton from "@components/LinkButton.astro";
---

<Layout title="Join Us | Urban Data & Equitable Cities" pageType="other">
  <main id="main-content" class="px-4 sm:px-6">
    <section class="join-container">
      <div class="join-header">
        <h1 class="join-title">Urban Data & Equitable Cities</h1>
        <p class="join-subtitle">Subscribe to our mailing list to receive updates on talks, activities, and collaborations.</p>
        <p class="join-subtitle">You will be asked to confirm your subscription by email. An admin will then manually approve your subscription. Once approved, you will receive a link to join our Slack channel.</p>
      </div>

      <div class="join-form">
        <LinkButton className="btn-primary" href="https://lists.cornell.edu/URBAN-DATA-SCIENCE-RG-L/subscribe/">Join Our Mailing List!</LinkButton>
      </div>

      <div class="join-links">
        <a class="underline" href="/">Back</a>
        <span aria-hidden>·</span>
        <a class="underline" href="https://bridges.eaamo.org/" target="_blank" rel="noopener">EAAMO Bridges</a>
      </div>
    </section>
  </main>
</Layout>
